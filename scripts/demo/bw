#!/bin/sh
# A fake bw for the README demo. It answers the bw commands that lazybw
# runs with the made-up items in items.json, and the trash with the items
# in trash.json, so that the demo needs no Bitwarden account. Any master
# password unlocks it. A restore does nothing.
#
# Use it only through demo.tape. It does not store changes.

dir=$(dirname "$0")

case "$1" in
status)
	# The last sync was 5 minutes ago.
	sync=$(date -u -d '5 minutes ago' +%Y-%m-%dT%H:%M:%S.000Z 2>/dev/null ||
		date -u -v-5M +%Y-%m-%dT%H:%M:%S.000Z)
	printf '{"serverUrl":null,"lastSync":"%s","userEmail":"alex.doe@example.com","userId":"demo","status":"locked"}\n' "$sync"
	;;
unlock | login)
	printf 'ZGVtby1zZXNzaW9uLXRva2Vu'
	;;
list)
	case " $* " in
	*" --trash "*) cat "$dir/trash.json" ;;
	*) cat "$dir/items.json" ;;
	esac
	;;
generate)
	printf 'vR7#kq2!Lm9@xT4$wZ8p\n'
	;;
get)
	echo "Not found." >&2
	exit 1
	;;
sync | lock | create | edit | delete | restore)
	;;
*)
	echo "demo bw: unknown command: $*" >&2
	exit 1
	;;
esac
